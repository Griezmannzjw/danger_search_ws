<launch>
  <!-- Formal entry point: runtime identity is intentionally not user-overridable. -->
  <arg name="simenv_root" default="$(find danger_search_bringup)/../../../simenvnew" />
  <arg name="result_file" default="$(arg simenv_root)/results/detected_danger.json" />
  <arg name="scene_info_file" default="$(arg simenv_root)/generated_building/team_scene_info.json" />
  <arg name="result_coordinate_frame" default="auto" />
  <arg name="autostart" default="false" />
  <arg name="entry_enabled" default="true" />
  <arg name="open_main_entrance" default="true" />

  <include file="$(find danger_search_bringup)/launch/system.launch">
    <arg name="simenv_root" value="$(arg simenv_root)" />
    <arg name="result_file" value="$(arg result_file)" />
    <arg name="scene_info_file" value="$(arg scene_info_file)" />
    <arg name="result_coordinate_frame" value="$(arg result_coordinate_frame)" />
    <arg name="autostart" value="$(arg autostart)" />
    <arg name="entry_enabled" value="$(arg entry_enabled)" />
    <arg name="open_main_entrance" value="$(arg open_main_entrance)" />
    <arg name="run_profile" value="formal" />
    <arg name="competition_mode" value="true" />
    <arg name="multifloor_enabled" value="true" />
    <arg name="localization_backend" value="gicp" />
    <arg name="use_hector_correction" value="false" />
    <arg name="gazebo_base_link" value="a1_gazebo::base" />
  </include>
</launch>
