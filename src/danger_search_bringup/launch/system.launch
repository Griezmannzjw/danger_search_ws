<launch>
  <!-- Internal assembly. Public callers use competition.launch or simulation_truth.launch. -->
  <arg name="simenv_root" default="$(find danger_search_bringup)/../../../SimEnv" />
  <arg name="result_file" default="$(arg simenv_root)/results/detected_danger.json" />
  <arg name="scene_info_file" default="$(arg simenv_root)/generated_building/team_scene_info.json" />
  <arg name="result_coordinate_frame" default="auto" />
  <arg name="autostart" default="false" />
  <arg name="entry_enabled" default="true" />
  <arg name="open_main_entrance" default="true" />
  <arg name="run_profile" default="formal" />
  <arg name="competition_mode" default="true" />
  <arg name="multifloor_enabled" default="true" />
  <arg name="localization_backend" default="gicp" />
  <arg name="use_hector_correction" default="false" />
  <arg name="gazebo_base_link" default="a1_gazebo::base" />

  <!-- These stay disabled for both profiles. simulation_truth receives only LinkStates. -->
  <env name="ENABLE_REFEREE_ODOM" value="0" />
  <env name="ENABLE_GROUND_TRUTH" value="0" />
  <env name="POINTCLOUD_USE_GROUND_TRUTH_ODOM" value="0" />

  <rosparam command="load" file="$(find danger_search_bringup)/config/global.yaml" />
  <param name="run_profile" value="$(arg run_profile)" />
  <param name="competition_mode" value="$(arg competition_mode)" />
  <param name="multifloor_enabled" value="$(arg multifloor_enabled)" />
  <param name="localization_backend" value="$(arg localization_backend)" />

  <include file="$(find danger_search_localization)/launch/localization.launch">
    <arg name="run_profile" value="$(arg run_profile)" />
    <arg name="competition_mode" value="$(arg competition_mode)" />
    <arg name="multifloor_enabled" value="$(arg multifloor_enabled)" />
    <arg name="localization_backend" value="$(arg localization_backend)" />
    <arg name="use_hector_correction" value="$(arg use_hector_correction)" />
    <arg name="gazebo_base_link" value="$(arg gazebo_base_link)" />
  </include>

  <node name="entrance_door" pkg="danger_search_bringup" type="entrance_door.py" output="screen">
    <param name="enabled" value="$(arg open_main_entrance)" />
    <param name="service_name" value="/set_door_state" />
    <param name="door_id" value="main_entrance" />
  </node>

  <node name="perception" pkg="danger_search_perception" type="danger_detector.py" output="screen">
    <rosparam command="load" file="$(find danger_search_bringup)/config/global.yaml" />
    <rosparam command="load" file="$(find danger_search_perception)/config/default.yaml" />
    <param name="run_profile" value="$(arg run_profile)" />
    <param name="competition_mode" value="$(arg competition_mode)" />
    <param name="multifloor_enabled" value="$(arg multifloor_enabled)" />
    <param name="localization_backend" value="$(arg localization_backend)" />
  </node>

  <include file="$(find danger_search_navigation)/launch/navigation.launch">
    <arg name="run_profile" value="$(arg run_profile)" />
    <arg name="competition_mode" value="$(arg competition_mode)" />
    <arg name="multifloor_enabled" value="$(arg multifloor_enabled)" />
    <arg name="localization_backend" value="$(arg localization_backend)" />
  </include>

  <node name="exploration" pkg="danger_search_exploration" type="exploration_planner.py" output="screen">
    <rosparam command="load" file="$(find danger_search_bringup)/config/global.yaml" />
    <rosparam command="load" file="$(find danger_search_exploration)/config/default.yaml" />
    <param name="run_profile" value="$(arg run_profile)" />
    <param name="competition_mode" value="$(arg competition_mode)" />
    <param name="multifloor_enabled" value="$(arg multifloor_enabled)" />
    <param name="localization_backend" value="$(arg localization_backend)" />
    <param name="scene_info_file" value="$(arg scene_info_file)" />
    <param name="entrance_boundary_guard_enabled" value="$(arg entry_enabled)" />
  </node>

  <node name="control" pkg="danger_search_control" type="cmd_mux.py" output="screen">
    <rosparam command="load" file="$(find danger_search_bringup)/config/global.yaml" />
    <rosparam command="load" file="$(find danger_search_control)/config/default.yaml" />
    <param name="run_profile" value="$(arg run_profile)" />
    <param name="competition_mode" value="$(arg competition_mode)" />
    <param name="multifloor_enabled" value="$(arg multifloor_enabled)" />
    <param name="localization_backend" value="$(arg localization_backend)" />
  </node>

  <node name="posture_safety_monitor" pkg="danger_search_control" type="posture_safety_monitor.py" output="screen">
    <rosparam command="load" file="$(find danger_search_control)/config/default.yaml" />
  </node>

  <node name="mission" pkg="danger_search_mission" type="mission_manager.py" output="screen">
    <rosparam command="load" file="$(find danger_search_bringup)/config/global.yaml" />
    <rosparam command="load" file="$(find danger_search_mission)/config/default.yaml" />
    <param name="result_file" value="$(arg result_file)" />
    <param name="autostart" value="$(arg autostart)" />
    <param name="entry_enabled" value="$(arg entry_enabled)" />
    <param name="run_profile" value="$(arg run_profile)" />
    <param name="competition_mode" value="$(arg competition_mode)" />
    <param name="multifloor_enabled" value="$(arg multifloor_enabled)" />
    <param name="localization_backend" value="$(arg localization_backend)" />
    <param name="scene_info_file" value="$(arg scene_info_file)" />
    <param name="result_coordinate_frame" value="$(arg result_coordinate_frame)" />
    <param name="require_preflight_ready" value="true" />
  </node>

  <node name="competition_preflight"
        pkg="danger_search_bringup"
        type="competition_preflight.py"
        output="screen"
        required="true">
    <param name="run_profile" value="$(arg run_profile)" />
    <param name="competition_mode" value="$(arg competition_mode)" />
    <param name="multifloor_enabled" value="$(arg multifloor_enabled)" />
    <param name="localization_backend" value="$(arg localization_backend)" />
    <param name="scene_info_file" value="$(arg scene_info_file)" />
    <param name="result_file" value="$(arg result_file)" />
    <param name="gazebo_base_link" value="$(arg gazebo_base_link)" />
    <param name="truth_link_max_age_s" value="1.0" />
    <param name="timeout_s" value="45.0" />
  </node>
</launch>
