<launch>
  <!-- Non-official integration profile.  Its result file can never overwrite formal output. -->
  <arg name="simenv_root" default="$(find danger_search_bringup)/../../../SimEnv" />
  <arg name="result_file" default="$(arg simenv_root)/results/detected_danger.simulation_truth.json" />
  <arg name="scene_info_file" default="$(arg simenv_root)/generated_building/team_scene_info.json" />
  <arg name="result_coordinate_frame" default="auto" />
  <arg name="autostart" default="false" />
  <arg name="entry_enabled" default="true" />
  <arg name="open_main_entrance" default="true" />
  <arg name="fixed_elevator_hall_enabled" default="false" />
  <arg name="fixed_elevator_hall_x" default="-2.40" />
  <arg name="fixed_elevator_hall_y" default="-1.65" />
  <arg name="fixed_elevator_hall_into_yaw" default="-1.5707963" />

  <include file="$(find danger_search_bringup)/launch/system.launch">
    <arg name="simenv_root" value="$(arg simenv_root)" />
    <arg name="result_file" value="$(arg result_file)" />
    <arg name="scene_info_file" value="$(arg scene_info_file)" />
    <arg name="result_coordinate_frame" value="$(arg result_coordinate_frame)" />
    <arg name="autostart" value="$(arg autostart)" />
    <arg name="entry_enabled" value="$(arg entry_enabled)" />
    <arg name="open_main_entrance" value="$(arg open_main_entrance)" />
    <arg name="run_profile" value="simulation_truth" />
    <arg name="competition_mode" value="false" />
    <arg name="multifloor_enabled" value="true" />
    <arg name="localization_backend" value="gazebo_truth" />
    <arg name="use_hector_correction" value="false" />
    <arg name="fixed_elevator_hall_enabled" value="$(arg fixed_elevator_hall_enabled)" />
    <arg name="fixed_elevator_hall_x" value="$(arg fixed_elevator_hall_x)" />
    <arg name="fixed_elevator_hall_y" value="$(arg fixed_elevator_hall_y)" />
    <arg name="fixed_elevator_hall_into_yaw" value="$(arg fixed_elevator_hall_into_yaw)" />
    <!-- Keep the only permitted truth input bound to the robot base.  This
         wrapper is an isolation boundary, not a generic LinkStates adapter. -->
    <arg name="gazebo_base_link" value="a1_gazebo::base" />
  </include>
</launch>
