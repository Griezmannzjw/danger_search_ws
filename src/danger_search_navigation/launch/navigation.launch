<launch>
  <arg name="config_dir" default="$(find danger_search_navigation)/config" />
  <arg name="run_profile" default="formal" />
  <arg name="competition_mode" default="true" />
  <arg name="multifloor_enabled" default="true" />
  <arg name="localization_backend" default="gicp" />

  <!-- Standard ROS navigation owns /move_base.  Its velocity output remains
       behind danger_search_control/cmd_mux. -->
  <node name="move_base" pkg="move_base" type="move_base" output="screen" clear_params="true">
    <rosparam command="load" file="$(arg config_dir)/standard_move_base.yaml" />
    <rosparam command="load" file="$(arg config_dir)/dwa_planner.yaml" />
    <rosparam command="load" file="$(arg config_dir)/costmap_common.yaml" ns="global_costmap" />
    <rosparam command="load" file="$(arg config_dir)/costmap_common.yaml" ns="local_costmap" />
    <rosparam command="load" file="$(arg config_dir)/global_costmap.yaml" ns="global_costmap" />
    <rosparam command="load" file="$(arg config_dir)/local_costmap.yaml" ns="local_costmap" />
    <param name="run_profile" value="$(arg run_profile)" />
    <param name="competition_mode" value="$(arg competition_mode)" />
    <param name="multifloor_enabled" value="$(arg multifloor_enabled)" />
    <param name="localization_backend" value="$(arg localization_backend)" />
    <remap from="cmd_vel" to="/danger_search/nav_cmd_vel" />
  </node>

  <!-- This only applies/validates the official dynamic-reconfigure settings;
       it never participates in velocity control. -->
  <node name="navigation_config_guard"
        pkg="danger_search_navigation"
        type="navigation_config_guard.py"
        output="screen">
    <param name="planner_name" value="/move_base/DWAPlannerROS" />
    <param name="planner_config_key" value="DWAPlannerROS" />
    <param name="safe_max_angular_speed_rps" value="0.40" />
    <param name="effective_min_in_place_angular_speed_rps" value="0.40" />
    <rosparam command="load" file="$(arg config_dir)/dwa_planner.yaml" />
    <param name="run_profile" value="$(arg run_profile)" />
    <param name="competition_mode" value="$(arg competition_mode)" />
    <param name="multifloor_enabled" value="$(arg multifloor_enabled)" />
    <param name="localization_backend" value="$(arg localization_backend)" />
  </node>

  <!-- Compatibility only: converts standard action/recovery state to the
       existing mission and exploration health contract. -->
  <node name="navigation_monitor"
        pkg="danger_search_navigation"
        type="navigation_monitor.py"
        output="screen">
    <rosparam command="load" file="$(arg config_dir)/monitor.yaml" />
    <param name="run_profile" value="$(arg run_profile)" />
    <param name="competition_mode" value="$(arg competition_mode)" />
    <param name="multifloor_enabled" value="$(arg multifloor_enabled)" />
    <param name="localization_backend" value="$(arg localization_backend)" />
  </node>
</launch>
