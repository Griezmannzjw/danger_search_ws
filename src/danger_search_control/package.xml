<?xml version="1.0"?>
<package format="2">
  <name>danger_search_control</name>
  <version>0.1.0</version>
  <description>Control execution layer: velocity mux and safety monitor</description>
  <maintainer email="team@example.com">Danger Search Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>rospy</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>danger_search_common</build_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>danger_search_common</exec_depend>

  <test_depend>python3-nose</test_depend>
  <test_depend>python3-yaml</test_depend>
</package>
