<launch>
  <arg name="config_file" default="$(find danger_search_localization)/config/default.yaml" />
  <!-- The validated simulator default is IMU-constrained GICP. FAST-LIO is
       retained only as an explicit experimental source because its planar
       corridor update remains rank-deficient during turns. -->
  <arg name="local_odometry_source" default="gicp" />
  <arg name="lio_odom_topic" default="/nav/lio_odom" />
  <arg name="lio_tracking_frame" default="imu_link" />

  <!-- 只读取官方原始 /scan；不读取 /Odometry_gazebo 或真值变换后的点云。 -->
  <node name="local_scan_projector"
        pkg="danger_search_localization"
        type="scan_projector.py"
        output="screen">
    <rosparam command="load" file="$(arg config_file)" />
  </node>

  <!-- Do not run GICP together with experimental LIO: both publish the same
       internal local-pose topic. -->
  <group if="$(eval arg('local_odometry_source') == 'gicp')">
    <node name="lidar_odometry"
          pkg="danger_search_localization"
          type="lidar_odometry_node"
          output="screen">
      <rosparam command="load" file="$(arg config_file)" />
    </node>
  </group>

  <group if="$(eval arg('local_odometry_source') == 'lio')">
    <node name="lio_odometry_bridge"
          pkg="danger_search_localization"
          type="lio_odometry_bridge.py"
          output="screen">
      <rosparam command="load" file="$(arg config_file)" />
      <param name="lio_odom_topic" value="$(arg lio_odom_topic)" />
      <param name="lio_tracking_frame" value="$(arg lio_tracking_frame)" />
    </node>
  </group>

  <!-- 将可信本地位姿作为建图已知位姿。Hector 只更新栅格，不再运行第二套
       容易在稀疏 Mid-360 扫描上漂移的 scan matcher。 -->
  <node name="known_pose_backend"
        pkg="danger_search_localization"
        type="known_pose_backend.py"
        output="screen">
    <rosparam command="load" file="$(arg config_file)" />
  </node>

  <node name="hector_mapping"
        pkg="hector_mapping"
        type="hector_mapping"
        output="screen">
    <rosparam command="load" file="$(arg config_file)" />
    <remap from="scan" to="/localization/scan" />
    <remap from="poseupdate" to="/localization/hector_pose" />
    <remap from="map" to="/localization/raw_map" />
    <param name="pub_map_odom_transform" value="false" />
    <param name="use_tf_scan_transformation" value="true" />
    <!-- Build the occupancy map at the trusted map->odom->base pose. -->
    <param name="use_tf_pose_start_estimate" value="true" />
    <param name="map_with_known_poses" value="true" />
  </node>

  <node name="localization_adapter"
        pkg="danger_search_localization"
        type="pose_estimator.py"
        output="screen">
    <rosparam command="load" file="$(arg config_file)" />
  </node>
</launch>
