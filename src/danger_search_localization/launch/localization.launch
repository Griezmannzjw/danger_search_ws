<launch>
  <arg name="config_file" default="$(find danger_search_localization)/config/default.yaml" />
  <arg name="run_profile" default="formal" />
  <arg name="competition_mode" default="true" />
  <arg name="multifloor_enabled" default="true" />
  <arg name="localization_backend" default="gicp" />
  <arg name="use_hector_correction" default="false" />
  <arg name="gazebo_base_link" default="a1_gazebo::base" />
  <!-- Resolve before any node starts: truth is test-only and formal runs are multi-floor. -->
  <arg name="_runtime_mode_guard"
       default="$(eval 'ok' if (arg('localization_backend') in ['gicp', 'gazebo_truth'] and (not arg('competition_mode') or (arg('multifloor_enabled') and arg('localization_backend') == 'gicp'))) else 1/0)" />
  <param name="/danger_search/localization_runtime_mode_guard"
         value="$(arg _runtime_mode_guard)" />

  <!-- 只读取官方原始 /scan；不读取 /Odometry_gazebo 或真值变换后的点云。 -->
  <node name="local_scan_projector"
        pkg="danger_search_localization"
        type="scan_projector.py"
        clear_params="true"
        output="screen">
    <rosparam command="load" file="$(arg config_file)" />
    <param name="run_profile" value="$(arg run_profile)" />
    <param name="competition_mode" value="$(arg competition_mode)" />
    <param name="multifloor_enabled" value="$(arg multifloor_enabled)" />
    <param name="localization_backend" value="$(arg localization_backend)" />
  </node>

  <!-- Front depth camera fills the Livox near/low blind zone for costmaps only. -->
    <node name="depth_obstacle_projector"
          pkg="danger_search_localization"
          type="depth_obstacle_projector.py"
          clear_params="true"
          output="screen">
    <rosparam command="load" file="$(arg config_file)" />
    <param name="run_profile" value="$(arg run_profile)" />
    <param name="competition_mode" value="$(arg competition_mode)" />
  </node>

  <!-- GICP 提供连续局部里程计，其健康状态参与 P0 readiness。 -->
  <group if="$(eval arg('localization_backend') == 'gicp')">
    <node name="lidar_odometry"
          pkg="danger_search_localization"
          type="lidar_odometry_node"
          clear_params="true"
          output="screen">
      <rosparam command="load" file="$(arg config_file)" />
      <param name="run_profile" value="$(arg run_profile)" />
      <param name="competition_mode" value="$(arg competition_mode)" />
      <param name="multifloor_enabled" value="$(arg multifloor_enabled)" />
      <param name="localization_backend" value="$(arg localization_backend)" />
    </node>
  </group>

  <!-- SimEnv integration test only. It publishes internal odometry, never TF. -->
  <group if="$(eval arg('localization_backend') == 'gazebo_truth')">
    <node name="gazebo_truth_odometry"
          pkg="danger_search_localization"
          type="gazebo_truth_odometry.py"
          clear_params="true"
          output="screen">
      <rosparam command="load" file="$(arg config_file)" />
      <param name="run_profile" value="$(arg run_profile)" />
      <param name="competition_mode" value="$(arg competition_mode)" />
      <param name="multifloor_enabled" value="$(arg multifloor_enabled)" />
      <param name="localization_backend" value="$(arg localization_backend)" />
      <!-- Test-only truth parameters are never loaded into formal nodes. -->
      <param name="gazebo_link_states_topic" value="/gazebo/link_states" />
      <param name="gazebo_base_link" value="$(arg gazebo_base_link)" />
      <param name="gazebo_truth_max_age_s" value="0.20" />
      <param name="gazebo_truth_max_future_s" value="0.05" />
      <param name="gazebo_truth_history_size" value="1000" />
      <param name="gazebo_truth_xy_variance" value="0.0001" />
      <param name="gazebo_truth_yaw_variance" value="0.0001" />
    </node>
  </group>

  <group if="$(eval arg('localization_backend') == 'gazebo_truth' or not arg('use_hector_correction'))">
    <node name="local_occupancy_mapper"
          pkg="danger_search_localization"
          type="occupancy_mapper.py"
          clear_params="true"
          output="screen">
      <rosparam command="load" file="$(arg config_file)" />
      <param name="run_profile" value="$(arg run_profile)" />
      <param name="competition_mode" value="$(arg competition_mode)" />
      <param name="multifloor_enabled" value="$(arg multifloor_enabled)" />
      <param name="localization_backend" value="$(arg localization_backend)" />
      <param name="explicit_floor_switching"
             value="$(arg multifloor_enabled)" />
    </node>
  </group>

  <!-- Optional compatibility backend. P0 defaults to the odometry-driven map. -->
  <group if="$(eval arg('localization_backend') == 'gicp' and arg('use_hector_correction'))">
    <node name="hector_mapping"
          pkg="hector_mapping"
          type="hector_mapping"
          output="screen">
      <rosparam command="load" file="$(arg config_file)" />
      <!-- Long-term map receives only rotation-safe scans; local costmaps keep /localization/scan. -->
      <remap from="scan" to="/localization/mapping_scan" />
      <remap from="poseupdate" to="/localization/hector_pose" />
      <remap from="map" to="/localization/raw_map" />
      <param name="pub_map_odom_transform" value="false" />
      <param name="use_tf_scan_transformation" value="true" />
      <param name="use_tf_pose_start_estimate" value="false" />
    </node>
  </group>

  <node name="localization_adapter"
        pkg="danger_search_localization"
        type="pose_estimator.py"
        clear_params="true"
        output="screen">
    <rosparam command="load" file="$(arg config_file)" />
    <param name="run_profile" value="$(arg run_profile)" />
    <param name="competition_mode" value="$(arg competition_mode)" />
    <param name="localization_backend" value="$(arg localization_backend)" />
    <param name="multifloor_enabled" value="$(arg multifloor_enabled)" />
    <param name="explicit_floor_switching" value="$(arg multifloor_enabled)" />
    <!-- Truth scans and poses share timestamps; do not extrapolate TF into the future. -->
    <param name="tf_publish_future_tolerance_s"
           value="$(eval 0.0 if arg('localization_backend') == 'gazebo_truth' else 0.5)" />
    <!-- Gazebo truth is already mission-relative and must not be low-pass lagged. -->
    <param name="pose_stabilizer_mode"
           value="$(eval 'trusted_passthrough' if arg('localization_backend') == 'gazebo_truth' else 'filtered_anchored')" />
    <param name="use_hector_correction"
           value="$(eval arg('localization_backend') == 'gicp' and arg('use_hector_correction'))" />
  </node>
</launch>
