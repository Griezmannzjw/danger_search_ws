<launch>
  <arg name="config_file" default="$(find danger_search_localization)/config/default.yaml" />

  <!-- SimEnv remains untouched. This adapter converts its PointCloud into a
       filtered PointCloud2 expressed in the robot IMU/base frame. -->
  <node name="sim_sensor_adapter"
        pkg="danger_search_localization"
        type="sim_sensor_adapter_node"
        output="screen">
    <rosparam command="load" file="$(arg config_file)" />
  </node>

  <!-- FAST-LIO2 in instantaneous-simulation (MARSIM) mode: tightly coupled
       IMU prediction plus scan-to-map correction replaces GICP and Hector. -->
  <node name="fast_lio_mapping"
        pkg="danger_search_localization"
        type="fast_lio_mapping"
        output="screen">
    <rosparam command="load" file="$(arg config_file)" />
    <remap from="/Odometry" to="/localization/lio/odometry" />
    <remap from="/cloud_registered" to="/localization/lio/cloud_registered" />
    <remap from="/cloud_registered_body" to="/localization/lio/cloud_body" />
    <remap from="/path" to="/localization/lio/path" />
  </node>

  <node name="lio_occupancy_mapper"
        pkg="danger_search_localization"
        type="lio_occupancy_mapper_node"
        output="screen">
    <rosparam command="load" file="$(arg config_file)" />
  </node>

  <node name="localization_adapter"
        pkg="danger_search_localization"
        type="lio_interface.py"
        output="screen">
    <rosparam command="load" file="$(arg config_file)" />
  </node>
</launch>
